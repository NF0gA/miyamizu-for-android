# soxr CMakeLists.txt override for Android NDK
# Place this as CMakeLists.txt in libs/soxr/src/

cmake_minimum_required(VERSION 3.22.1)
project(soxr C)

set(CMAKE_C_STANDARD 11)

set(SOXR_SOURCES
    cr32.c
    cr64.c
    vr32.c
    filter.c
    fft4g32.c
    fft4g64.c
    util.c
    dataio.c
)

# Disable SIMD for compatibility, enable if targeting arm64 with NEON
set(SOXR_DEFINES
    SOXR_LIB
    HAVE_STDINT_H=1
    HAVE_FENV_H=1
    HAVE_LRINT=1
    HAVE_LRINTF=1
)

if(ANDROID_ABI STREQUAL "arm64-v8a")
    list(APPEND SOXR_SOURCES ../libsoxr/cr32s.c)
    list(APPEND SOXR_DEFINES SOXR_ENABLE_SSE_AND_SSE2=0)
else()
    list(APPEND SOXR_DEFINES SOXR_ENABLE_SSE_AND_SSE2=0)
endif()

add_library(soxr STATIC ${SOXR_SOURCES})

target_compile_definitions(soxr PRIVATE ${SOXR_DEFINES})

target_include_directories(soxr PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}/../libsoxr
)

target_compile_options(soxr PRIVATE -O3 -fPIC -Wall -Wextra)
